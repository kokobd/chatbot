# IAP authentication provider. Production uses Google's rotating public keys.
IAP_AUTH_PROVIDER=google
# Direct Cloud Run IAP audience:
# /projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME
IAP_JWT_AUDIENCE=****
# Optional overrides:
# IAP_JWT_ISSUER=https://cloud.google.com/iap
# For local development, set IAP_AUTH_PROVIDER=test. The test provider reads
# x-goog-authenticated-user-email and x-goog-authenticated-user-id request
# headers; it does not use environment variables for the test identity.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=****

# optional metadata used by OpenRouter rankings
OPENROUTER_HTTP_REFERER=http://localhost:8080
OPENROUTER_APP_NAME=Chatbot

# GCS bucket used for user-uploaded images. The bucket must allow public reads.
GCS_BUCKET=****
# Optional private GCS JSON object containing runtime environment secrets.
# Cloud Run sets this through Terraform; local development may set it when
# Application Default Credentials can read the object.
SECRETS_GCS_PATH=gs://****/test/app.json
# Local test runs select IAP_AUTH_PROVIDER=test. Production must never use
# test mode; Cloud Run requests arrive through IAP.
# Local development can use Application Default Credentials:
# gcloud auth application-default login
# Production can use an attached service account or this standard ADC variable:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
