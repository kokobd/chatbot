# IAP authentication provider. Production uses Google's rotating public keys.
IAP_AUTH_PROVIDER=google
# Direct Cloud Run IAP audience:
# /projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME
IAP_JWT_AUDIENCE=****
# Optional overrides:
# IAP_JWT_ISSUER=https://cloud.google.com/iap
# IAP_JWT_PUBLIC_KEYS_URL=https://www.gstatic.com/iap/verify/public_key
# For local development, set IAP_AUTH_PROVIDER=test and provide the identity
# that the local Next proxy should add to incoming requests:
# IAP_TEST_EMAIL=local@example.com
# IAP_TEST_SUBJECT=local-development-user

# https://openrouter.ai/keys
OPENROUTER_API_KEY=****

# optional metadata used by OpenRouter rankings
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=Chatbot

# GCS bucket used for user-uploaded images. The bucket must allow public reads.
GCS_BUCKET=****
# Local Playwright/test runs select IAP_AUTH_PROVIDER=test and inject the
# standard IAP identity headers. Production must never use test mode.
# Local development can use Application Default Credentials:
# gcloud auth application-default login
# Production can use an attached service account or this standard ADC variable:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****
