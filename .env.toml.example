# Copy this file to .env.toml and replace the placeholder values. Nushell can
# load it with: open .env.toml | from toml | load-env

# The local server uses the test IAP provider. It accepts the
# x-goog-authenticated-user-email and x-goog-authenticated-user-id headers.
IAP_AUTH_PROVIDER = "test"
PORT = 8080

# https://openrouter.ai/keys
OPENROUTER_API_KEY = "replace-me"

# Optional metadata used by OpenRouter rankings.
OPENROUTER_HTTP_REFERER = "http://localhost:8080"
OPENROUTER_APP_NAME = "Chatbot"

# Terraform test-workspace outputs.
GCS_BUCKET = "replace-me"
FIRESTORE_PROJECT_ID = "replace-me"
FIRESTORE_DATABASE_ID = "replace-me"

# Optional private GCS JSON object containing runtime environment secrets.
# SECRETS_GCS_PATH = "gs://bucket/test/app.json"

# Optional Google IAP settings when IAP_AUTH_PROVIDER = "google".
# IAP_JWT_AUDIENCE = "/projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME"
# IAP_JWT_ISSUER = "https://cloud.google.com/iap"
